        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "from sklearn.impute import SimpleImputer\n",
        "from sklearn.model_selection import KFold\n",
        "from sklearn.metrics import get_scorer\n",
        "from sklearn.preprocessing import LabelEncoder\n",
        "from sklearn.linear_model import ElasticNet\n",
        "from sklearn.ensemble import RandomForestRegressor\n",
        "from xgboost import XGBRegressor\n",
        "from lightgbm import LGBMRegressor\n",
        "\n",
        "def analisis_automatico(archivo, respuesta, excluir=(),\n",
        "                        semilla=SEMILLA):\n",
        "    df = pd.read_csv(archivo)\n",
        "    df = df.drop(columns=list(excluir), errors=\"ignore\")\n",
        "    df = df.dropna(subset=[respuesta])\n",
        "    y = df.pop(respuesta)\n",
        "    X = pd.get_dummies(df, drop_first=True).astype(float)  # codifica\n",
        "    X = X.loc[:, X.std() > 0]                # quita las constantes\n",
        "    clasif = ((not pd.api.types.is_numeric_dtype(y))\n",
        "              or y.nunique() <= 10)\n",
        "    imp = lambda m: make_pipeline(SimpleImputer(strategy=\"median\"), m)\n",
        "    if clasif:\n",
        "        y = pd.Series(LabelEncoder().fit_transform(y), index=y.index)\n",
        "        k = y.nunique()\n",
        "        metrica = \"roc_auc\" if k == 2 else \"roc_auc_ovr\"\n",
        "        cv = StratifiedKFold(5, shuffle=True, random_state=semilla)\n",
        "        modelos = {\n",
        "          \"Elastic Net\": imp(make_pipeline(StandardScaler(),\n",
        "              LogisticRegression(penalty=\"elasticnet\", solver=\"saga\",\n",
        "                                 l1_ratio=0.5, max_iter=5000))),\n",
        "          \"Random Forest\": imp(RandomForestClassifier(300,\n",
        "                                 random_state=semilla)),\n",
        "          \"XGBoost\": XGBClassifier(n_estimators=300, max_depth=3,\n",
        "              learning_rate=0.05, random_state=semilla),\n",
        "          \"LightGBM\": LGBMClassifier(n_estimators=300, verbose=-1,\n",
        "              learning_rate=0.05, random_state=semilla)}\n",
        "        estrato = y\n",
        "        print(f\"Clasificación con {k} clases. Proporciones:\",\n",
        "              y.value_counts(normalize=True).round(3).to_dict())\n",
        "    else:\n",
        "        metrica = \"neg_root_mean_squared_error\"\n",
        "        cv = KFold(5, shuffle=True, random_state=semilla)\n",
        "        modelos = {\n",
        "          \"Elastic Net\": imp(make_pipeline(StandardScaler(),\n",
        "                                           ElasticNet(alpha=0.1))),\n",
        "          \"Random Forest\": imp(RandomForestRegressor(300,\n",
        "                                 random_state=semilla)),\n",
        "          \"XGBoost\": XGBRegressor(n_estimators=300, max_depth=3,\n",
        "              learning_rate=0.05, random_state=semilla),\n",
        "          \"LightGBM\": LGBMRegressor(n_estimators=300, verbose=-1,\n",
        "              learning_rate=0.05, random_state=semilla)}\n",
        "        estrato = None\n",
        "        print(\"Regresión: la métrica es el RMSE (menor es mejor)\")\n",
        "    X_tr, X_te, y_tr, y_te = train_test_split(X, y, test_size=0.25,\n",
        "        stratify=estrato, random_state=semilla)\n",
        "    print(f\"Entrenamiento: {len(X_tr)} | Prueba: {len(X_te)}\")\n",
        "    filas = []\n",
        "    for nombre, m in modelos.items():\n",
        "        s = cross_val_score(m, X_tr, y_tr, cv=cv, scoring=metrica)\n",
        "        m.fit(X_tr, y_tr)\n",
        "        prueba = get_scorer(metrica)(m, X_te, y_te)\n",
        "        signo = -1 if metrica.startswith(\"neg\") else 1\n",
        "        filas.append({\"modelo\": nombre, \"cv_media\": signo * s.mean(),\n",
        "                      \"cv_desv\": s.std(), \"prueba\": signo * prueba})\n",
        "    tabla = pd.DataFrame(filas).round(4)\n",
        "    mejor = tabla.sort_values(\"cv_media\",\n",
        "        ascending=not clasif).iloc[0]\n",
        "    base = tabla.set_index(\"modelo\").loc[\"Elastic Net\"]\n",
