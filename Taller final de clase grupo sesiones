        "    elif dif <= tabla[\"cv_desv\"].max():\n",
        "        print(\"Criterio: la diferencia con Elastic Net es menor que \"\n",
        "              \"la variabilidad: por parsimonia, prefiere Elastic Net\")\n",
        "    else:\n",
        "        print(f\"Criterio: {mejor['modelo']} supera a Elastic Net por \"\n",
        "              \"más que la variabilidad de la validación cruzada.\")\n",
