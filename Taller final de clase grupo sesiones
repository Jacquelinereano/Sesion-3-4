        "def comparar_modelos(X, y, modelos, semilla=SEMILLA):\n",
        "    \"\"\"Divide, valida y devuelve una tabla comparativa.\"\"\"\n",
        "    X_tr, X_te, y_tr, y_te = train_test_split(\n",
        "        X, y, test_size=0.25, stratify=y, random_state=semilla)\n",
        "    cv = StratifiedKFold(5, shuffle=True, random_state=semilla)\n",
        "    filas = []\n",
        "    for nombre, m in modelos.items():\n",
        "        auc = cross_val_score(m, X_tr, y_tr, cv=cv,\n",
        "                              scoring=\"roc_auc\")\n",
        "        m.fit(X_tr, y_tr)\n",
        "        prueba = roc_auc_score(y_te, m.predict_proba(X_te)[:, 1])\n",
        "        filas.append({\"modelo\": nombre, \"AUC_cv\": auc.mean(),\n",
        "                      \"desv_cv\": auc.std(), \"AUC_prueba\": prueba})\n",
        "    return pd.DataFrame(filas).round(4)\n",
        "\n",
        "tabla = comparar_modelos(X, y, modelos)        # una sola línea\n",
        "tabla.to_csv(\"comparacion_modelos.csv\", index=False)\n",
        "tabla"
